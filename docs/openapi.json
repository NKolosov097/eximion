  "components": {
    "schemas": {
      "Account": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username"
        ],
        "title": "Account"
      },
      "AnalyticsSummary": {
        "properties": {
          "days": {
            "type": "integer",
            "enum": [
              7,
              30,
              90
            ],
            "title": "Days"
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "title": "Start At"
          },
          "end_at": {
            "type": "string",
            "format": "date-time",
            "title": "End At"
          },
          "case_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Case Count"
          },
          "attempt_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Attempt Count"
          },
          "correct_attempt_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Correct Attempt Count"
          },
          "correct_percentage": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Correct Percentage"
          }
        },
        "type": "object",
        "required": [
          "days",
          "start_at",
          "end_at",
