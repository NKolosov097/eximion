{
  "openapi": "3.1.0",
  "info": {
    "title": "Clinical Cases API - Test Assignment for Eximion",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/clinical-cases/extract": {
      "post": {
        "summary": "Extract Clinical Case",
        "operationId": "extract_clinical_case_api_v1_clinical_cases_extract_post",
        "parameters": [
          {
            "name": "x-author-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Author-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gateway Timeout"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/clinical-cases": {
      "post": {
        "summary": "Create Clinical Case",
        "operationId": "create_clinical_case_api_v1_clinical_cases_post",
        "parameters": [
          {
            "name": "x-author-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Author-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClinicalCaseCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicalCase"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List Clinical Cases",
        "operationId": "list_clinical_cases_api_v1_clinical_cases_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000000,
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Page Size"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[^\\x00]*$",
              "description": "Case-insensitive literal search in public titles and vignettes.",
              "default": "",
              "title": "Q"
            },
            "description": "Case-insensitive literal search in public titles and vignettes."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicalCasePage"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/clinical-cases/{id}": {
      "get": {
        "summary": "Get Clinical Case",
        "operationId": "get_clinical_case_api_v1_clinical_cases__id__get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicalCase"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/clinical-cases/{id}/attempts": {
      "post": {
        "summary": "Create Attempt",
        "operationId": "create_attempt_api_v1_clinical_cases__id__attempts_post",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttemptCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttemptResult"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AttemptCreate": {
        "properties": {
          "diagnosis": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Diagnosis"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "diagnosis"
        ],
        "title": "AttemptCreate"
      },
      "AttemptResult": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "clinical_case_id": {
            "type": "string",
            "format": "uuid",
            "title": "Clinical Case Id"
          },
          "score": {
            "type": "integer",
            "enum": [
              0,
              100
            ],
            "title": "Score"
          },
          "max_score": {
            "type": "integer",
            "const": 100,
            "title": "Max Score"
          },
          "is_correct": {
            "type": "boolean",
            "title": "Is Correct"
          },
          "feedback": {
            "type": "string",
            "title": "Feedback"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "clinical_case_id",
          "score",
          "max_score",
          "is_correct",
          "feedback",
          "created_at"
        ],
        "title": "AttemptResult"
      },
      "ClinicalCase": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Title"
          },
          "vignette": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Vignette"
          },
          "symptoms": {
            "items": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[^\\x00]*$"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Symptoms"
          },
          "age_years": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 120.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Age Years"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "vignette",
          "symptoms",
          "age_years",
          "id",
          "created_at"
        ],
        "title": "ClinicalCase"
      },
      "ClinicalCaseCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Title"
          },
          "vignette": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Vignette"
          },
          "symptoms": {
            "items": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[^\\x00]*$"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Symptoms"
          },
          "age_years": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 120.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Age Years"
          },
          "reference_diagnosis": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Reference Diagnosis"
          },
          "accepted_answers": {
            "items": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[^\\x00]*$"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Accepted Answers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "vignette",
          "symptoms",
          "reference_diagnosis"
        ],
        "title": "ClinicalCaseCreate"
      },
      "ClinicalCaseDraft": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Title"
          },
          "vignette": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Vignette"
          },
          "symptoms": {
            "items": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[^\\x00]*$"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Symptoms"
          },
          "age_years": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 120.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Age Years"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "vignette",
          "symptoms"
        ],
        "title": "ClinicalCaseDraft"
      },
      "ClinicalCasePage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ClinicalCase"
            },
            "type": "array",
            "title": "Items"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More"
          }
        },
        "type": "object",
        "required": [
          "items",
          "has_more"
        ],
        "title": "ClinicalCasePage"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "ExtractionRequest": {
        "properties": {
          "source_text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 20,
            "title": "Source Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_text"
        ],
        "title": "ExtractionRequest"
      },
      "ExtractionResponse": {
        "properties": {
          "draft": {
            "$ref": "#/components/schemas/ClinicalCaseDraft"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "draft",
          "warnings"
        ],
        "title": "ExtractionResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
